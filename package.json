{
  "name": "backchannel",
  "version": "0.3.0",
  "private": true,
  "workspaces": [
    "web"
  ],
  "scripts": {
    "build": "npm --workspace web run build",
    "check": "npm run test:capture-contract && npm run capture:verify && npm --workspace web run check && uv run ruff check server scripts tests && uv run mypy server scripts/start.py scripts/docker_smoke.py scripts/export_openapi.py scripts/secret_scan.py && uv run pytest -q",
    "capture:judge": "npm run test:e2e",
    "capture:verify": "node e2e/capture-manifest.mjs",
    "openapi:export": "uv run python scripts/export_openapi.py",
    "openapi:check": "uv run python scripts/export_openapi.py --check",
    "pretest:e2e": "npm run build",
    "secret:scan": "uv run python scripts/secret_scan.py",
    "presmoke:deployed-defaults": "npm run build",
    "presmoke:production": "npm run build",
    "smoke:container": "uv run python scripts/docker_smoke.py",
    "smoke:deployed-defaults": "uv run python scripts/docker_smoke.py --launch --profile deployed-readonly",
    "smoke:docker": "uv run python scripts/docker_smoke.py",
    "smoke:stub": "node scripts/smoke-stub.mjs",
    "smoke:live": "uv run python -m scripts.smoke_live",
    "smoke:live:3": "uv run python -m scripts.smoke_live_three",
    "smoke:production": "uv run python scripts/docker_smoke.py --launch",
    "start": "uv run python scripts/start.py",
    "test": "npm --workspace web test -- --run",
    "test:capture-contract": "node --test e2e/judge-flow.test.mjs e2e/capture-manifest.test.mjs",
    "test:e2e": "npm run test:capture-contract && node e2e/judge-flow.mjs"
  },
  "engines": {
    "node": ">=22.13 <23"
  },
  "devDependencies": {
    "playwright-core": "1.61.1"
  }
}
