# Optional. Keep the value server-side; the browser receives only liveReady.
OPENAI_API_KEY=

# Required whenever live or deployed mode is enabled. Use a stable, randomly
# generated secret of at least 32 UTF-8 bytes; never commit its real value.
BACKCHANNEL_IDENTITY_HMAC_SECRET=

# Public deployment hardening. Origins must be exact HTTPS origins. Forwarded
# headers stay ignored unless the immediate proxy's CIDR is listed explicitly.
BACKCHANNEL_DEPLOYED=false
BACKCHANNEL_CORS_ORIGINS=
BACKCHANNEL_TRUSTED_PROXY_CIDRS=

# Durable state and bounded public-demo controls.
BACKCHANNEL_DB_PATH=backchannel.sqlite3
BACKCHANNEL_MAX_REQUEST_BODY_BYTES=16384
BACKCHANNEL_LIVE_MAX_CONCURRENT=1
BACKCHANNEL_LIVE_COOLDOWN_SECONDS=30
BACKCHANNEL_LIVE_DAILY_BUDGET=12
BACKCHANNEL_DEMO_SESSION_TTL_SECONDS=86400
BACKCHANNEL_RECOVERY_TTL_SECONDS=604800
BACKCHANNEL_CLEANUP_INTERVAL_SECONDS=300
BACKCHANNEL_CLEANUP_BATCH_SIZE=100

# Destructive demo reset stays disabled unless a disposable environment opts in.
BACKCHANNEL_DEMO_RESET_ENABLED=false

# The live semaphore is process-local. Public deployments must use one worker and
# leave Uvicorn proxy rewriting disabled so the app validates trusted hops itself:
# Disable the raw access log unless a sanitized access logger is configured.
# uv run uvicorn server.main:app --workers 1 --no-proxy-headers --no-access-log
