# Optional. Keep the value server-side; the browser receives only liveReady.
OPENAI_API_KEY=

# Capture-only destructive demo reset. Deployed mode rejects true; packaged,
# container, and public profiles must leave it false.
BACKCHANNEL_DEMO_RESET_ENABLED=false

# Public-demo controls. "Budget units" count admitted live demo recoveries;
# they are not a claim about money, tokens, or provider billing accuracy.
BACKCHANNEL_MAX_CONCURRENT_LIVE_RECOVERIES=2
BACKCHANNEL_LIVE_IP_COOLDOWN_SECONDS=60
BACKCHANNEL_LIVE_SESSION_COOLDOWN_SECONDS=60
BACKCHANNEL_DAILY_DEMO_BUDGET_UNITS=100
BACKCHANNEL_LIVE_ADMISSION_LEASE_SECONDS=300
BACKCHANNEL_TERMINAL_RECOVERY_TTL_SECONDS=86400
BACKCHANNEL_TERMINAL_CLEANUP_INTERVAL_SECONDS=300
BACKCHANNEL_REQUEST_BODY_SIZE_LIMIT_BYTES=16384
BACKCHANNEL_DEMO_SESSION_LIFETIME_SECONDS=86400

# Durable creation-ledger admission. Per-session, opaque-IP, and global gates
# are independent; the per-session bound cannot exceed the global bound.
# Existing request keys remain retryable at capacity.
BACKCHANNEL_MAX_RECOVERY_CREATIONS_PER_SESSION=32
BACKCHANNEL_MAX_RECOVERY_CREATIONS_PER_IP=128
BACKCHANNEL_MAX_RECOVERY_CREATIONS_GLOBAL=2048

# Process-local SSE admission. Capacity fails fast with a finite control event;
# native EventSource reconnects after the advertised retry interval.
BACKCHANNEL_MAX_CONCURRENT_EVENT_STREAMS=16
BACKCHANNEL_MAX_EVENT_STREAMS_PER_RECOVERY=4
BACKCHANNEL_EVENT_STREAM_RETRY_SECONDS=5

# Deployment hardening. Deployed mode requires exact HTTPS origins and a
# private 32+ byte identity-hash secret shared by every app instance.
BACKCHANNEL_DEPLOYED_MODE=false
BACKCHANNEL_CORS_ORIGINS=
# BACKCHANNEL_IDENTITY_HASH_SECRET=replace-with-at-least-32-random-bytes
BACKCHANNEL_TRUSTED_PROXY_ENABLED=false
# Required when proxy trust is enabled. Requests are trusted only when their
# direct peer is in this exact comma-separated CIDR allowlist.
BACKCHANNEL_TRUSTED_PROXY_CIDRS=
BACKCHANNEL_DEMO_SESSION_COOKIE_SECURE=false
