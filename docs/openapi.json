{
  "components": {
    "schemas": {
      "ApprovalDecisionRequest": {
        "additionalProperties": false,
        "properties": {
          "clientDecisionId": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "title": "Clientdecisionid",
            "type": "string"
          },
          "decision": {
            "enum": [
              "approve",
              "decline"
            ],
            "title": "Decision",
            "type": "string"
          },
          "remedyDigest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "title": "Remedydigest",
            "type": "string"
          },
          "remedyId": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "title": "Remedyid",
            "type": "string"
          },
          "toolCallId": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "title": "Toolcallid",
            "type": "string"
          }
        },
        "required": [
          "decision",
          "clientDecisionId",
          "remedyId",
          "remedyDigest",
          "toolCallId"
        ],
        "title": "ApprovalDecisionRequest",
        "type": "object"
      },
      "ApprovalDecisionResponse": {
        "additionalProperties": false,
        "properties": {
          "approvedRemedyDigest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "title": "Approvedremedydigest",
            "type": "string"
          },
          "clientDecisionId": {
            "title": "Clientdecisionid",
            "type": "string"
          },
          "decision": {
            "const": "approve",
            "title": "Decision",
            "type": "string"
          },
          "executionStarted": {
            "const": true,
            "title": "Executionstarted",
            "type": "boolean"
          },
          "recoveryId": {
            "title": "Recoveryid",
            "type": "string"
          },
          "status": {
            "const": "completed",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "clientDecisionId",
          "recoveryId",
          "decision",
          "status",
          "approvedRemedyDigest",
          "executionStarted"
        ],
        "title": "ApprovalDecisionResponse",
        "type": "object"
      },
