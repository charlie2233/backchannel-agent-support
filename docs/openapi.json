  "info": {
    "title": "Backchannel API",
    "version": "0.3.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/demo/reset": {
      "post": {
        "operationId": "reset_demo_api_demo_reset_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoResetResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicErrorResponse"
                }
              }
            },
            "description": "The request was rejected with a public error envelope."
          }
        },
        "summary": "Reset Demo"
      }
    },
