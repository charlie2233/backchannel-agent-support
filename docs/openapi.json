  "info": {
    "title": "Backchannel API",
    "version": "0.3.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/demo/reset": {
      "post": {
        "operationId": "reset_demo_api_demo_reset_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoResetResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Reset Demo"
      }
    },
    "/api/recoveries": {
      "post": {
        "operationId": "create_recovery_api_recoveries_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRecoveryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoverySnapshot"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Recovery"
      }
    },
    "/api/recoveries/{recovery_id}": {
      "get": {
        "description": "Requires the signed opaque demo session issued when the recovery was created. Missing, expired, tampered, unrelated, and unknown sessions receive the same generic not-found response.",
        "operationId": "get_recovery_api_recoveries__recovery_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "recovery_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Recovery Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoverySnapshot"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Recovery not found."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Recovery"
      }
    },
    "/api/recoveries/{recovery_id}/decisions": {
      "post": {
        "description": "Requires the signed opaque demo session issued when the recovery was created. Missing, expired, tampered, unrelated, and unknown sessions receive the same generic not-found response.",
        "operationId": "approve_recovery_api_recoveries__recovery_id__decisions_post",
        "parameters": [
          {
            "in": "path",
            "name": "recovery_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Recovery Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "action": {
                    "enum": [
                      "approve",
                      "decline"
                    ],
                    "title": "DecisionAction",
                    "type": "string"
                  },
                  "clientDecisionId": {
                    "maxLength": 128,
                    "minLength": 1,
                    "title": "Clientdecisionid",
                    "type": "string"
                  },
                  "remedyDigest": {
                    "pattern": "^sha256:[0-9a-f]{64}$",
                    "title": "Remedydigest",
                    "type": "string"
                  },
                  "remedyId": {
                    "maxLength": 128,
                    "minLength": 1,
                    "title": "Remedyid",
                    "type": "string"
                  },
                  "toolCallId": {
                    "maxLength": 256,
                    "minLength": 1,
                    "title": "Toolcallid",
                    "type": "string"
                  }
                },
                "required": [
                  "action",
                  "clientDecisionId",
                  "remedyId",
                  "remedyDigest",
                  "toolCallId"
                ],
                "title": "ApprovalDecisionRequest",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalDecisionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Recovery not found."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "detail": {
                          "additionalProperties": false,
                          "properties": {
                            "code": {
                              "enum": [
                                "authority_denied",
                                "constraint_denied",
                                "decision_body_invalid",
                                "remedy_digest_mismatch",
                                "remedy_expired",
                                "remedy_mismatch",
                                "tool_call_mismatch"
                              ],
                              "type": "string"
                            },
                            "recoveryId": {
                              "format": "uuid",
                              "type": "string"
                            }
                          },
                          "required": [
                            "code",
                            "recoveryId"
                          ],
                          "type": "object"
                        }
                      },
                      "required": [
                        "detail"
                      ],
                      "type": "object"
                    },
                    {
                      "additionalProperties": false,
                      "properties": {
                        "code": {
                          "enum": [
                            "invalid_request"
                          ],
                          "type": "string"
                        },
                        "message": {
                          "enum": [
                            "The request did not match the public API contract."
                          ],
                          "type": "string"
                        },
                        "requestId": {
                          "pattern": "^[0-9a-f]{32}$",
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message",
                        "requestId"
                      ],
                      "type": "object"
                    }
                  ]
                }
              }
            },
            "description": "The authenticated decision body or consent is invalid, or the recovery path is not a valid UUID."
          }
        },
        "summary": "Approve Recovery"
      }
    },
    "/api/recoveries/{recovery_id}/decisions/resume": {
      "post": {
        "description": "Requires the signed opaque demo session issued when the recovery was created. Missing, expired, tampered, unrelated, and unknown sessions receive the same generic not-found response. Explicitly continues only the existing durable decision claim; the empty request cannot create or alter consent.",
        "operationId": "resume_recovery_decision_api_recoveries__recovery_id__decisions_resume_post",
        "parameters": [
          {
            "in": "path",
            "name": "recovery_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Recovery Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "maxProperties": 0,
                "properties": {},
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
